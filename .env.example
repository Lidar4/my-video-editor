# Supabase public values are safe to expose to the browser when used with RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only values. Never prefix these with NEXT_PUBLIC_ and never commit real values.
SUPABASE_SERVICE_ROLE_KEY=
RENDER_QUEUE_URL=

# Provider secrets belong in the server/worker secret manager, not the frontend.
AI_PROVIDER_API_KEY=
TTS_PROVIDER_API_KEY=
VIDEO_PROVIDER_API_KEY=
